# Build Options
#   change yes to no to disable
#
BOOTMAGIC_ENABLE = no      # Enable Bootmagic Lite, change keys w/o flashing    
EXTRAKEY_ENABLE = no       # Audio control and System control
#NKRO_ENABLE = no           # Enable N-Key Rollover
#SPLIT_KEYBOARD = yes
ENCODER_ENABLE = no		  # Enables support for rotary encoders.
LTO_ENABLE = yes          # Enables Link Time Optimization (drastically reduces size)
CONSOLE_ENABLE = no       # Disables debugging console
COMMAND_ENABLE = no       # Disables Magic Commands (bootloader access, debug)
BACKLIGHT_ENABLE = no     # Disables keyboard backlight functionality, monochrome lights
AUDIO_ENABLE = no         # Disables speaker/audio
VIA_ENABLE = no           # Disables VIA configurator (saves ~3KB)
RGBLIGHT_ENABLE = no	 # Disables RGB Matrix
MOUSEKEY_ENABLE = yes    # Enables Mouse Keys
RGB_MATRIX_ENABLE = yes	 # Enables RGB Matrix	